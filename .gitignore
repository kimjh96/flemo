# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Build outputs
dist
.next
out
build
*.tsbuildinfo

# Turbo
.turbo

# Fumadocs MDX, regenerated by the fumadocs-mdx CLI on every dev/build
**/.source/

# Dependencies
node_modules

# Env
.env
.env.local
.env.*.local

# Editors
.idea
.vscode
.cursor

# Lervo's generated knowledge publications. The concepts they are rendered from
# are tracked under .lervo/knowledge; these are the human-readable projection and
# are rewritten by every refresh. Tracking them also puts them under the staged-file
# prettier hook, which reformats them and breaks the byte binding lint checks.
/docs/knowledge/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
*storybook.log
firebase-debug.log

# Coverage
coverage

# Playwright
**/playwright-report
**/test-results
**/.playwright
.localpack*/
# lervo:begin rebuildable-knowledge schema=1
docs/knowledge/
# lervo:end rebuildable-knowledge
